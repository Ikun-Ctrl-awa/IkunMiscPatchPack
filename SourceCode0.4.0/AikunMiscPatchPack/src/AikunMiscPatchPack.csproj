   <_LocalInput Include="$(PatchInputsDir)/assets/card-art/mod-form-0.3.0-concept-v1.png" />
   <_LocalInput Include="$(PatchInputsDir)/assets/card-art/qu-curse-0.4.0-v8.png" />
   <_LocalInput Include="$(PatchInputsDir)/assets/CardFusion-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/CardFusion-10EB2C911D25-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/CardFusion-7B6FD1EDB04C-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/ColumbinaMod-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/ColumbinaMod-2.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/ColumbinaMod-3.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/DixieRelicSort-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/event-art/blood-sect-initiation-0.4.0-v1.png" />
   <_LocalInput Include="$(PatchInputsDir)/assets/event-art/dongni-office-0.4.0-v1.png" />
   <_LocalInput Include="$(PatchInputsDir)/assets/event-art/thunder-sect-initiation-0.4.0-v1.png" />
   <_LocalInput Include="$(PatchInputsDir)/assets/FusionExpansionPack-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/FusionExpansionPack-2.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/FusionExpansionPack-3.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/Gravity-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/heart-keys/key_blue.png" />
   <_LocalInput Include="$(PatchInputsDir)/assets/heart-keys/key_green.png" />
   <_LocalInput Include="$(PatchInputsDir)/assets/heart-keys/key_red.png" />
   <_LocalInput Include="$(PatchInputsDir)/assets/heart-keys/key_slots.png" />
   <_LocalInput Include="$(PatchInputsDir)/assets/Medo-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/plague-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/RelicRewardChoices-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/YUICore-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/YUICore-2.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/YUICore-3.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/assets/YuWanCard.Content-1.xor.br" />
   <_LocalInput Include="$(PatchInputsDir)/catalog.json" />
  </ItemGroup>
  <Error Condition="!Exists('%(_LocalInput.Identity)')" Text="缺少本地构建输入：%(_LocalInput.Identity)。请配置 Local.Build.props；源码包不附带游戏、SDK、差分或图片。" />
 </Target>
</Project>
