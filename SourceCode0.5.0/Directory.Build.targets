<Project><Target Name="ValidatePrivateInputs" BeforeTargets="PrepareForBuild" Condition="'$(MSBuildProjectName)'=='IkunMiscPatchPack'"><Error Condition="'$(GameManagedDir)'=='' or '$(RitsuSdkDir)'=='' or '$(PatchInputsDir)'==''" Text="请配置 Local.Build.props 或 STS2_* 环境变量，禁止使用缺少资源的构建发布。"/><Exec Command="python -X utf8 &quot;$(RepositoryRoot)scripts/check_inputs.py&quot; --root &quot;$(PatchInputsDir)&quot;"/></Target></Project>