<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><TargetFramework>net9.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>IkunMiscPatchPack</AssemblyName><Version>0.5.0</Version></PropertyGroup>
 <PropertyGroup Condition="'$(Configuration)'=='Release'"><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols></PropertyGroup>
 <ItemGroup>
